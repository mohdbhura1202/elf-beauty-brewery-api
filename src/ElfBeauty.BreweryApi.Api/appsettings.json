{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "OpenBreweryDb": {
    "BaseUrl": "https://api.openbrewerydb.org/v1/breweries",
    "PageSize": 200,
    "MaxPages": 5
  },
  "Cache": {
    "DurationMinutes": 10
  },
  "Storage": {
    "Provider": "InMemory"
  },
  "ConnectionStrings": {
    "BreweryDb": "Data Source=brewery.db"
  },
  "ApiKeySettings": {
    "ApiKey": "",
    "HeaderName": "X-Api-Key"
  },
  "AllowedHosts": "*"
}

