{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Brewery API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/ElfBeauty.BreweryApi.Api/bin/Debug/net8.0/ElfBeauty.BreweryApi.Api.dll",
      "cwd": "${workspaceFolder}/src/ElfBeauty.BreweryApi.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
